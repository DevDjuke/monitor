# Public DNS name. Point this hostname at the server before first start so Caddy can obtain TLS.
MONITOR_HOST=monitor.example.com

# Bootstrap administrator. The password is written to deploy/single-node/secrets by prepare-secrets.sh.
MONITOR_ADMIN_EMAIL=admin@example.com
MONITOR_BOOTSTRAP_PASSWORD=replace-with-a-long-random-password

# SQL Server Express SA password. Keep deploy/single-node/.env out of source control.
MSSQL_SA_PASSWORD=replace-with-a-long-random-sql-password

# Optional shared migration/bootstrap ingestion key. Prefer per-component credentials after setup.
MONITOR_INGESTION_API_KEY=

# Single-node deployments may migrate on startup. Set false if migrations are run explicitly with --migrate-only.
MONITOR_MIGRATE_ON_STARTUP=true

# Override only when ports 80/443 are already occupied.
MONITOR_HTTP_PORT=80
MONITOR_HTTPS_PORT=443
