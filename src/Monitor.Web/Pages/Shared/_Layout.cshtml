<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <title>@ViewData["Title"] · Monitor</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/failure-alerts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <div class="shell">
        <aside class="sidebar">
            <a class="brand" href="/">
                <span class="brand-mark"><i></i><i></i><i></i></span>
                <span>MONITOR</span>
            </a>
            <nav class="nav" aria-label="Primary">
                <a href="/">Overview</a>
                <a href="/components">Components</a>
                <a href="/runs">Runs</a>
                <a href="/usage">Usage</a>
                <a href="/alerts">Alerts</a>
            </nav>
            <div class="sidebar-account">
                <span class="account-email">@User.Identity?.Name</span>
                <form method="post" asp-page="/Account/Logout">
                    <button type="submit" class="signout-button">Sign out</button>
                </form>
            </div>
            <div class="sidebar-foot">
                <span class="live-dot"></span>
                Control plane online
            </div>
        </aside>
        <main class="main">
            @RenderBody()
        </main>
    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
