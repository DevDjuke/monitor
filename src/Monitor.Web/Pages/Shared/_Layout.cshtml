@{
    var monitorRole = MonitorRoles.All.FirstOrDefault(role => User.IsInRole(role)) ?? "Unassigned";
    var canAudit = User.IsInRole(MonitorRoles.Owner) || User.IsInRole(MonitorRoles.Auditor);
    var canManageOperators = User.IsInRole(MonitorRoles.Owner);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <title>@ViewData["Title"] · Monitor</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/saved-views.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/failure-alerts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/alert-delivery.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/alert-rules.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/logs.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/budgets.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/audit.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <div class="shell">
        <aside class="sidebar">
            <a class="brand" href="/">
                <span class="brand-mark"><i></i><i></i><i></i></span>
                <span>MONITOR</span>
            </a>
            <nav class="nav" aria-label="Primary">
                <a href="/">Overview</a>
                <a href="/components">Components</a>
                <a href="/commands">Commands</a>
                <a href="/saved-views">Saved views</a>
                <a href="/runs">Runs</a>
                <a href="/logs">Logs</a>
                <a href="/usage">Usage</a>
                <a href="/budgets">Budgets</a>
                <a href="/alerts">Alerts</a>
                <a href="/alerts/rules">Alert rules</a>
                @if (canAudit)
                {
                    <a href="/audit">Audit</a>
                }
                @if (canManageOperators)
                {
                    <a href="/operators">Operators</a>
                }
            </nav>
            @await Component.InvokeAsync("PinnedSavedViews")
            <div class="sidebar-account">
                <span class="account-email">@User.Identity?.Name</span>
                <span class="account-role">@monitorRole</span>
                <form method="post" asp-page="/Account/Logout">
                    <button type="submit" class="signout-button">Sign out</button>
                </form>
            </div>
            <div class="sidebar-foot">
                <span class="live-dot"></span>
                Control plane online
            </div>
        </aside>
        <main class="main">
            @RenderBody()
        </main>
    </div>
    <script src="~/js/saved-views.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
