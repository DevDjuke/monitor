@page "/alerts"
@model AlertsModel
@{
    ViewData["Title"] = "Alerts";
}

@section Head {
    <link rel="stylesheet" href="~/css/filters.css" asp-append-version="true" />
}

<header class="page-head compact">
    <div>
        <p class="eyebrow">FAILURE ALERTING</p>
        <h1>Alerts</h1>
        <p class="lede">Operational alert events with durable multi-channel delivery, retries, dead-letter inspection, and provider-specific payloads.</p>
    </div>
</header>

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="notice success-notice">@statusMessage</div>
}

<div asp-validation-summary="All" class="validation-summary"></div>

<section class="panel filter-panel" aria-label="Alert filters">
    <form method="get" class="filter-grid">
        <label class="filter-field">
            <span>Window</span>
            <select asp-for="Window">
                <option value="24h">Last 24 hours</option>
                <option value="7d">Last 7 days</option>
                <option value="30d">Last 30 days</option>
                <option value="all">All retained history</option>
            </select>
        </label>

        <label class="filter-field wide">
            <span>Search</span>
            <input asp-for="Search" type="search" autocomplete="off" placeholder="Rule, operation, type, dependency, fingerprint, destination, error…" />
        </label>

        <label class="filter-field">
            <span>Failure category</span>
            <select asp-for="Category">
                <option value="">All categories</option>
                @foreach (var category in Model.FailureCategories)
                {
                    <option value="@category">@category</option>
                }
            </select>
        </label>

        <label class="filter-field">
            <span>Alert state</span>
            <select asp-for="AlertState">
                <option value="all">All alerts</option>
                <option value="open">Open</option>
                <option value="acknowledged">Acknowledged</option>
            </select>
        </label>

        <label class="filter-field">
            <span>Rule state</span>
            <select asp-for="RuleState">
                <option value="all">All rules</option>
                <option value="enabled">Enabled</option>
                <option value="disabled">Disabled</option>
            </select>
        </label>

        <label class="filter-field">
            <span>Delivery state</span>
            <select asp-for="DeliveryStatus">
                <option value="">All deliveries</option>
                @foreach (var status in Model.DeliveryStatuses)
                {
                    <option value="@status">@status</option>
                }
            </select>
        </label>

        <label class="filter-field">
            <span>Destination</span>
            <select asp-for="DestinationId">
                <option value="">All destinations</option>
                @foreach (var destination in Model.Destinations)
                {
                    <option value="@destination.Id">@destination.Name</option>
                }
            </select>
        </label>

        <div class="filter-actions">
            <button class="filter-apply" type="submit">Apply filters</button>
            <a class="filter-clear" href="/alerts">Clear</a>
        </div>
    </form>
</section>

<p class="filter-context"><strong>Operational scope:</strong> @Model.ScopeLabel. Time/state filters affect their matching sections; destination configuration itself remains global.</p>

<section class="metrics" aria-label="Alert summary">
    <article class="metric">
        <span>Alerts in scope</span>
        <strong>@Model.MatchingAlerts.ToString("N0")</strong>
        <small>matching alert events</small>
    </article>
    <article class="metric">
        <span>Open in scope</span>
        <strong>@Model.OpenAlerts.ToString("N0")</strong>
        <small>awaiting acknowledgement</small>
    </article>
    <article class="metric">
        <span>Rules in scope</span>
        <strong>@Model.MatchingRules.ToString("N0")</strong>
        <small>matching detection policies</small>
    </article>
    <article class="metric">
        <span>Affected groups</span>
        <strong>@Model.AffectedGroups.ToString("N0")</strong>
        <small>matching fingerprints</small>
    </article>
</section>

<section class="metrics delivery-metrics" aria-label="Delivery summary">
    <article class="metric">
        <span>Enabled destinations</span>
        <strong>@Model.EnabledDestinations.ToString("N0")</strong>
        <small>global configuration</small>
    </article>
    <article class="metric">
        <span>Deliveries in scope</span>
        <strong>@Model.MatchingDeliveries.ToString("N0")</strong>
        <small>matching outbox items</small>
    </article>
    <article class="metric">
        <span>Queued / retrying</span>
        <strong>@Model.PendingDeliveries.ToString("N0")</strong>
        <small>matching durable work</small>
    </article>
    <article class="metric">
        <span>Dead letters</span>
        <strong>@Model.DeadLetterDeliveries.ToString("N0")</strong>
        <small>matching operator attention</small>
    </article>
</section>

<section class="failure-alert-grid delivery-config-grid">
    <article class="panel table-panel delivery-destinations-panel">
        <div class="panel-head">
            <div>
                <p class="eyebrow">DELIVERY DESTINATIONS</p>
                <h2>Notification channels</h2>
            </div>
            <span>@Model.Destinations.Count configured · global</span>
        </div>

        @if (Model.Destinations.Count == 0)
        {
            <div class="empty compact-empty"><strong>No delivery destinations.</strong><span>Add a webhook, chat, incident, or email channel and future alert events will enqueue durable deliveries for it.</span></div>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr><th>Destination</th><th>Health</th><th>Delivered</th><th>Dead</th><th></th></tr>
                    </thead>
                    <tbody>
                    @foreach (var destination in Model.Destinations)
                    {
                        <tr>
                            <td>
                                <strong>@destination.Name</strong>
                                <small>@AlertsModel.DisplayKind(destination.Kind)</small>
                                <small class="endpoint-url">@destination.EndpointUrl</small>
                                <small><span class="status-dot @(destination.Enabled ? "healthy" : "unknown")"></span> @(destination.Enabled ? "Enabled" : "Disabled")</small>
                            </td>
                            <td>
                                @if (destination.LastFailureAt is not null && (destination.LastSuccessAt is null || destination.LastFailureAt > destination.LastSuccessAt))
                                {
                                    <span class="alert-state open">Failing</span>
                                    <small title="@destination.LastFailure">@destination.LastFailureAt.Value.ToString("MM-dd HH:mm:ss") UTC</small>
                                }
                                else if (destination.LastSuccessAt is not null)
                                {
                                    <span class="alert-state acknowledged">Healthy</span>
                                    <small>@destination.LastSuccessAt.Value.ToString("MM-dd HH:mm:ss") UTC</small>
                                }
                                else
                                {
                                    <span class="alert-state neutral">Untested</span>
                                }
                            </td>
                            <td>@destination.Delivered.ToString("N0")</td>
                            <td>@destination.DeadLetters.ToString("N0")</td>
                            <td class="delivery-actions">
                                <form method="post" asp-page-handler="TestDestination" asp-route-destinationId="@destination.Id">
                                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                                    <button class="inline-button" type="submit" title="@(destination.Kind == Monitor.Domain.AlertDeliveryKind.PagerDuty ? "PagerDuty tests create a real informational incident." : "Send a provider-native test notification.")">Test</button>
                                </form>
                                <form method="post" asp-page-handler="ToggleDestination" asp-route-destinationId="@destination.Id">
                                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                                    <button class="inline-button" type="submit">@(destination.Enabled ? "Disable" : "Enable")</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </article>

    <article class="panel">
        <div class="panel-head">
            <div>
                <p class="eyebrow">ADD DESTINATION</p>
                <h2>Delivery adapter</h2>
            </div>
        </div>
        <form method="post" asp-page-handler="CreateDestination" class="alert-form" id="destination-form">
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
            <label>
                <span>Name</span>
                <input asp-for="DestinationInput.Name" placeholder="Operations notifications" autocomplete="off" />
            </label>
            <label>
                <span>Type</span>
                <select asp-for="DestinationInput.Kind" id="destination-kind">
                    @foreach (var kind in Model.DestinationKinds)
                    {
                        <option value="@kind">@AlertsModel.DisplayKind(kind)</option>
                    }
                </select>
            </label>
            <label data-destination-kinds="Webhook,Slack,MicrosoftTeams,Discord">
                <span>Endpoint URL</span>
                <input asp-for="DestinationInput.EndpointUrl" placeholder="https://…" autocomplete="url" />
                <small data-endpoint-help>Chat webhook URLs are encrypted at rest and only a redacted host is shown after creation.</small>
            </label>
            <label data-destination-kinds="Webhook,PagerDuty">
                <span data-secret-label>Signing secret / routing key</span>
                <input asp-for="DestinationInput.Secret" type="password" autocomplete="new-password" />
                <small data-secret-help>Signed webhooks require at least 16 characters. PagerDuty uses the Events API v2 routing key.</small>
            </label>
            <label data-destination-kinds="Email">
                <span>Recipient</span>
                <input asp-for="DestinationInput.EmailRecipient" type="email" placeholder="ops@example.com" autocomplete="email" />
            </label>
            <label data-destination-kinds="Email">
                <span>SMTP host</span>
                <input asp-for="DestinationInput.SmtpHost" placeholder="smtp.example.com" autocomplete="off" />
            </label>
            <label data-destination-kinds="Email">
                <span>SMTP port</span>
                <input asp-for="DestinationInput.SmtpPort" type="number" min="1" max="65535" />
            </label>
            <label data-destination-kinds="Email">
                <span>From address</span>
                <input asp-for="DestinationInput.SmtpFromAddress" type="email" placeholder="monitor@example.com" autocomplete="email" />
            </label>
            <label data-destination-kinds="Email">
                <span>SMTP username</span>
                <input asp-for="DestinationInput.SmtpUserName" autocomplete="username" />
            </label>
            <label data-destination-kinds="Email">
                <span>SMTP password</span>
                <input asp-for="DestinationInput.SmtpPassword" type="password" autocomplete="new-password" />
                <small>SMTP credentials are encrypted with ASP.NET Core Data Protection and never copied into audit snapshots.</small>
            </label>
            <label data-destination-kinds="Email">
                <span><input asp-for="DestinationInput.SmtpEnableSsl" type="checkbox" /> Use TLS/SSL</span>
            </label>
            <button class="primary-action" type="submit">Add destination</button>
            <p class="form-hint">Slack, Teams, Discord, PagerDuty, and email reuse the same durable outbox, retries, dead-letter state, per-rule/per-budget routing, health, and audit trail as signed webhooks.</p>
        </form>
    </article>
</section>

<section class="panel table-panel alert-deliveries-table-panel">
    <div class="panel-head">
        <div>
            <p class="eyebrow">DELIVERY OUTBOX</p>
            <h2>Recent notifications</h2>
        </div>
        <span>@Model.RecentDeliveries.Count shown · @Model.MatchingDeliveries.ToString("N0") matching</span>
    </div>

    @if (Model.RecentDeliveries.Count == 0)
    {
        <div class="empty"><strong>No notification deliveries match these filters.</strong><span>Change the delivery filters or wait for a matching alert event.</span></div>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr><th>Destination</th><th>Alert</th><th>Status</th><th>Attempts</th><th>Transport</th><th>Last attempt</th><th>Error</th><th></th></tr>
                </thead>
                <tbody>
                @foreach (var delivery in Model.RecentDeliveries)
                {
                    <tr>
                        <td><strong>@delivery.DestinationName</strong><small>@delivery.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss") UTC</small></td>
                        <td><a class="table-link" href="/failures/@delivery.FailureGroupId">@delivery.AlertEventId.ToString()[..8]</a></td>
                        <td><span class="delivery-state @delivery.Status.ToString().ToLowerInvariant()">@delivery.Status</span></td>
                        <td>@delivery.AttemptCount</td>
                        <td>@(delivery.ResponseStatusCode?.ToString() ?? "—")</td>
                        <td>
                            @if (delivery.DeliveredAt is not null)
                            {
                                <span>@delivery.DeliveredAt.Value.ToString("MM-dd HH:mm:ss") UTC</span>
                            }
                            else if (delivery.LastAttemptAt is not null)
                            {
                                <span>@delivery.LastAttemptAt.Value.ToString("MM-dd HH:mm:ss") UTC</span>
                                @if (delivery.Status == Monitor.Domain.AlertDeliveryStatus.RetryScheduled)
                                {
                                    <small>next @delivery.NextAttemptAt.ToString("MM-dd HH:mm:ss") UTC</small>
                                }
                            }
                            else
                            {
                                <span>Not attempted</span>
                            }
                        </td>
                        <td class="error-cell" title="@delivery.LastError">@(delivery.LastError ?? "—")</td>
                        <td>
                            @if (delivery.Status != Monitor.Domain.AlertDeliveryStatus.Delivered)
                            {
                                <form method="post" asp-page-handler="RequeueDelivery" asp-route-deliveryId="@delivery.Id">
                                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                                    <button class="inline-button" type="submit">Retry now</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="panel table-panel alerts-table-panel">
    <div class="panel-head">
        <div>
            <p class="eyebrow">ALERT EVENTS</p>
            <h2>Recent triggers</h2>
        </div>
        <span>@Model.RecentAlerts.Count shown · @Model.MatchingAlerts.ToString("N0") matching</span>
    </div>

    @if (Model.RecentAlerts.Count == 0)
    {
        <div class="empty"><strong>No alerts match these filters.</strong><span>Change the alert filters or wait for a matching failure fingerprint to cross a rule threshold.</span></div>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr><th>Failure group</th><th>Rule</th><th>Observed</th><th>Delivery</th><th>Triggered</th><th>State</th><th></th></tr>
                </thead>
                <tbody>
                @foreach (var alert in Model.RecentAlerts)
                {
                    <tr>
                        <td>
                            <a class="table-link" href="/failures/@alert.FailureGroupId">@alert.Category · @alert.Operation</a>
                            <small>@(alert.FailureType ?? alert.Dependency ?? "Unknown type")</small>
                        </td>
                        <td><strong>@alert.RuleName</strong><small>@alert.WindowStart.ToString("HH:mm")–@alert.WindowEnd.ToString("HH:mm") UTC window</small></td>
                        <td><strong>@alert.OccurrencesInWindow / @alert.Threshold</strong><small>occurrences / threshold</small></td>
                        <td>
                            <strong>@alert.DeliveredNotifications delivered</strong>
                            <small>@alert.PendingNotifications queued · @alert.DeadLetterNotifications dead</small>
                        </td>
                        <td>@alert.TriggeredAt.ToString("yyyy-MM-dd HH:mm:ss") UTC</td>
                        <td>
                            @if (alert.AcknowledgedAt is null)
                            {
                                <span class="alert-state open">Open</span>
                            }
                            else
                            {
                                <span class="alert-state acknowledged">Acknowledged</span>
                                <small>@alert.AcknowledgedBy · @alert.AcknowledgedAt.Value.ToString("MM-dd HH:mm") UTC</small>
                            }
                        </td>
                        <td>
                            @if (alert.AcknowledgedAt is null)
                            {
                                <form method="post" asp-page-handler="Acknowledge" asp-route-eventId="@alert.Id">
                                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                                    <button class="inline-button" type="submit">Acknowledge</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="panel table-panel alert-rules-table-panel">
    <div class="panel-head">
        <div>
            <p class="eyebrow">RULES</p>
            <h2>Detection policies</h2>
        </div>
        <span>@Model.Rules.Count shown · @Model.MatchingRules.ToString("N0") matching</span>
    </div>

    @if (Model.Rules.Count == 0)
    {
        <div class="empty"><strong>No alert rules match these filters.</strong><span>Change the rule filters or create a threshold rule from a recurring failure.</span></div>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr><th>Rule</th><th>Fingerprint</th><th>Condition</th><th>Last evaluation</th><th>Last fired</th><th>Open</th><th></th></tr>
                </thead>
                <tbody>
                @foreach (var rule in Model.Rules)
                {
                    <tr>
                        <td>
                            <strong>@rule.Name</strong>
                            <small><span class="status-dot @(rule.Enabled ? "healthy" : "unknown")"></span> @(rule.Enabled ? "Enabled" : "Disabled")</small>
                        </td>
                        <td><a class="table-link" href="/failures/@rule.FailureGroupId">@rule.Category · @rule.Operation</a></td>
                        <td><strong>@rule.Threshold / @rule.WindowMinutes min</strong><small>@rule.CooldownMinutes min cooldown</small></td>
                        <td>@(rule.LastEvaluatedAt?.ToString("yyyy-MM-dd HH:mm:ss") ?? "Never") UTC</td>
                        <td>@(rule.LastTriggeredAt?.ToString("yyyy-MM-dd HH:mm:ss") ?? "Never") UTC</td>
                        <td>@rule.OpenAlerts.ToString("N0")</td>
                        <td>
                            <form method="post" asp-page-handler="ToggleRule" asp-route-ruleId="@rule.Id">
                                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                                <button class="inline-button" type="submit">@(rule.Enabled ? "Disable" : "Enable")</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<script>
(() => {
    const kindSelect = document.getElementById('destination-kind');
    if (!kindSelect) return;

    const groups = Array.from(document.querySelectorAll('[data-destination-kinds]'));
    const secretLabel = document.querySelector('[data-secret-label]');
    const secretHelp = document.querySelector('[data-secret-help]');
    const endpointHelp = document.querySelector('[data-endpoint-help]');

    const sync = () => {
        const kind = kindSelect.value;
        groups.forEach(group => {
            const kinds = group.dataset.destinationKinds.split(',');
            group.hidden = !kinds.includes(kind);
        });

        if (secretLabel) {
            secretLabel.textContent = kind === 'PagerDuty' ? 'Routing key' : 'Signing secret';
        }
        if (secretHelp) {
            secretHelp.textContent = kind === 'PagerDuty'
                ? 'PagerDuty Events API v2 integration/routing key. Testing creates a real informational incident.'
                : 'At least 16 characters. Stored encrypted and used to HMAC-sign timestamp.body.';
        }
        if (endpointHelp) {
            endpointHelp.textContent = kind === 'Webhook'
                ? 'Monitor posts canonical JSON and signs timestamp.body with HMAC-SHA256.'
                : 'Provider webhook URLs are encrypted at rest; only a redacted host is retained for display/audit.';
        }
    };

    kindSelect.addEventListener('change', sync);
    sync();
})();
</script>
