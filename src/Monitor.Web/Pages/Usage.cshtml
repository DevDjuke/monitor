@page "/usage"
@model UsageModel
@{
    ViewData["Title"] = "Usage";
}

@section Head {
    <link rel="stylesheet" href="~/css/filters.css" asp-append-version="true" />
}

<header class="page-head compact">
    <div>
        <p class="eyebrow">RETENTION / AGGREGATION</p>
        <h1>Usage</h1>
        <p class="lede">Durable execution metrics backed by hourly aggregates, with failure evidence kept raw and recurring failures grouped for investigation.</p>
    </div>
</header>

<section class="panel filter-panel" aria-label="Usage filters">
    <form method="get" class="filter-grid">
        <label class="filter-field">
            <span>Window</span>
            <select asp-for="Window">
                <option value="24h">Last 24 hours</option>
                <option value="48h">Last 48 hours</option>
                <option value="7d">Last 7 days</option>
                <option value="30d">Last 30 days</option>
                <option value="all">All retained history</option>
            </select>
        </label>

        <label class="filter-field">
            <span>Component</span>
            <select asp-for="ComponentId">
                <option value="">All components</option>
                @foreach (var component in Model.ComponentOptions)
                {
                    <option value="@component.Id">@component.Name · @component.Environment</option>
                }
            </select>
        </label>

        <label class="filter-field">
            <span>Environment</span>
            <select asp-for="Environment">
                <option value="">All environments</option>
                @foreach (var environment in Model.EnvironmentOptions)
                {
                    <option value="@environment">@environment</option>
                }
            </select>
        </label>

        <label class="filter-field">
            <span>Model</span>
            <select asp-for="Model">
                <option value="">All models</option>
                @foreach (var model in Model.ModelOptions)
                {
                    <option value="@model">@model</option>
                }
            </select>
        </label>

        <label class="filter-field">
            <span>Failure category</span>
            <select asp-for="FailureCategory">
                <option value="">All categories</option>
                @foreach (var category in Model.FailureCategories)
                {
                    <option value="@category">@category</option>
                }
            </select>
        </label>

        <label class="filter-field wide">
            <span>Failure search</span>
            <input asp-for="FailureSearch" type="search" autocomplete="off" placeholder="Operation, type, dependency, template, fingerprint…" />
        </label>

        <div class="filter-actions">
            <button class="filter-apply" type="submit">Apply filters</button>
            <a class="filter-clear" href="/usage">Clear</a>
        </div>
    </form>
</section>

<p class="filter-context"><strong>Usage scope:</strong> @Model.ScopeLabel. Failure category/search apply only to the recurring-failure table.</p>

<section class="metrics" aria-label="Aggregated usage summary">
    <article class="metric">
        <span>Terminal runs</span>
        <strong>@Model.TotalRuns.ToString("N0")</strong>
        <small>aggregated + pending · current scope</small>
    </article>
    <article class="metric">
        <span>Success rate</span>
        <strong>@Model.SuccessRate.ToString("0.0")%</strong>
        <small>@Model.SuccessRuns.ToString("N0") successful · @Model.FailedRuns.ToString("N0") failed</small>
    </article>
    <article class="metric">
        <span>Tokens</span>
        <strong>@((Model.InputTokens + Model.OutputTokens).ToString("N0"))</strong>
        <small>@Model.InputTokens.ToString("N0") in · @Model.OutputTokens.ToString("N0") out</small>
    </article>
    <article class="metric">
        <span>Cost</span>
        <strong>$@Model.CostUsd.ToString("0.00")</strong>
        <small>reported estimate · current scope</small>
    </article>
</section>

<div class="dashboard-grid">
    <section class="panel">
        <div class="panel-head">
            <div>
                <p class="eyebrow">RETENTION STATE</p>
                <h2>Raw evidence</h2>
            </div>
            <span>current usage scope</span>
        </div>
        <div class="rows">
            <div class="system-row">
                <span class="status-dot healthy"></span>
                <div class="row-main"><strong>@Model.StoredRawRuns.ToString("N0") raw runs stored</strong><span>Matching recent successes, running work, and forensic failures.</span></div>
            </div>
            <div class="system-row">
                <span class="status-dot healthy"></span>
                <div class="row-main"><strong>@Model.RetainedSuccessfulRuns.ToString("N0") successful runs retained</strong><span>Eligible for purge only after aggregation and the detail-retention window.</span></div>
            </div>
            <div class="system-row">
                <span class="status-dot degraded"></span>
                <div class="row-main"><strong>@Model.ForensicRuns.ToString("N0") forensic runs retained</strong><span>Failed and cancelled runs are never purged by the retention worker.</span></div>
            </div>
            <div class="system-row">
                <span class="status-dot unknown"></span>
                <div class="row-main"><strong>@Model.PendingAggregation.ToString("N0") terminal runs pending aggregation</strong><span>These remain counted from raw data until their durable aggregate is committed.</span></div>
            </div>
        </div>
    </section>

    <section class="panel">
        <div class="panel-head">
            <div>
                <p class="eyebrow">POLICY</p>
                <h2>Current retention</h2>
            </div>
            <span>global configuration</span>
        </div>
        <div class="rows">
            <div class="system-row"><div class="row-main"><strong>@(Model.RetentionEnabled ? "Enabled" : "Disabled")</strong><span>Background retention worker</span></div></div>
            <div class="system-row"><div class="row-main"><strong>@Model.AggregationDelayMinutes min</strong><span>Terminal-run aggregation delay</span></div></div>
            <div class="system-row"><div class="row-main"><strong>@Model.SuccessfulRunDetailDays days</strong><span>Successful raw-detail retention</span></div></div>
            <div class="system-row"><div class="row-main"><strong>@Model.SweepIntervalMinutes min</strong><span>Retention sweep interval</span></div></div>
            <div class="system-row"><div class="row-main"><strong>Indefinite</strong><span>Failed and cancelled raw-detail retention</span></div></div>
        </div>
    </section>
</div>

<section class="panel table-panel">
    <div class="panel-head">
        <div>
            <p class="eyebrow">FAILURE FINGERPRINTS</p>
            <h2>Recurring failure groups</h2>
        </div>
        <span>@Model.TopFailureGroups.Count shown · <a href="/alerts">Alert operations</a></span>
    </div>

    @if (Model.TopFailureGroups.Count == 0)
    {
        <div class="empty"><strong>No grouped failures match this scope.</strong><span>Change the filters or wait for failed/cancelled runs to be classified.</span></div>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr><th>Category</th><th>Operation</th><th>Type / dependency</th><th>Status</th><th>Occurrences</th><th>Last seen</th></tr>
                </thead>
                <tbody>
                @foreach (var failure in Model.TopFailureGroups)
                {
                    <tr>
                        <td><a class="table-link" href="/failures/@failure.Id">@failure.Category</a></td>
                        <td>
                            <a class="table-link" href="/failures/@failure.Id">@failure.Operation</a>
                            @if (!string.IsNullOrWhiteSpace(failure.MessageTemplate))
                            {
                                <div class="muted">@failure.MessageTemplate</div>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(failure.FailureType))
                            {
                                <strong>@failure.FailureType</strong>
                            }
                            @if (!string.IsNullOrWhiteSpace(failure.Dependency))
                            {
                                <div class="muted">@failure.Dependency</div>
                            }
                            @if (string.IsNullOrWhiteSpace(failure.FailureType) && string.IsNullOrWhiteSpace(failure.Dependency))
                            {
                                <span>—</span>
                            }
                        </td>
                        <td>@(failure.HttpStatusCode?.ToString() ?? "—")</td>
                        <td>@failure.Occurrences.ToString("N0")</td>
                        <td>@(failure.LastSeenAt?.ToString("yyyy-MM-dd HH:mm") ?? "—") UTC</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="panel table-panel">
    <div class="panel-head">
        <div>
            <p class="eyebrow">HOURLY AGGREGATES</p>
            <h2>@Model.RecentBucketLabel</h2>
        </div>
        <span>@Model.RecentBuckets.Count buckets shown</span>
    </div>

    @if (Model.RecentBuckets.Count == 0)
    {
        <div class="empty"><strong>No aggregate buckets match this scope.</strong><span>Terminal runs become eligible after the configured aggregation delay.</span></div>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr><th>Hour UTC</th><th>Runs</th><th>Success</th><th>Failed</th><th>Cancelled</th><th>Avg duration</th><th>Tokens</th><th>Cost</th></tr>
                </thead>
                <tbody>
                @foreach (var bucket in Model.RecentBuckets)
                {
                    <tr>
                        <td><strong>@bucket.BucketStart.ToString("yyyy-MM-dd HH:00")</strong></td>
                        <td>@bucket.TotalRuns.ToString("N0")</td>
                        <td>@bucket.SuccessRuns.ToString("N0")</td>
                        <td>@bucket.FailedRuns.ToString("N0")</td>
                        <td>@bucket.CancelledRuns.ToString("N0")</td>
                        <td>@bucket.AverageDurationMs.ToString("N0") ms</td>
                        <td>@bucket.Tokens.ToString("N0")</td>
                        <td>$@bucket.CostUsd.ToString("0.0000")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
