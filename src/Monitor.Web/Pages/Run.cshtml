@page "/run/{id:guid}"
@model RunModel
@{
    ViewData["Title"] = Model.Run.Name;
    var statusClass = Model.Run.Status.ToString().ToLowerInvariant();
    TimeSpan? duration = Model.Run.CompletedAt is null ? null : Model.Run.CompletedAt.Value - Model.Run.StartedAt;
}

<header class="page-head compact run-head">
    <div>
        <p class="eyebrow">RUN / @Model.Run.Id</p>
        <h1>@Model.Run.Name</h1>
        <p class="lede">@Model.Run.Component.Name · @Model.Run.StartedAt.ToString("u")</p>
    </div>
    <span class="run-status @statusClass">@Model.Run.Status</span>
</header>

<section class="run-facts">
    <div><span>Duration</span><strong>@(duration is null ? "running" : $"{duration.Value.TotalMilliseconds:0} ms")</strong></div>
    <div><span>Model</span><strong>@(Model.Run.Model ?? "—")</strong></div>
    <div><span>Input tokens</span><strong>@Model.Run.InputTokens.ToString("N0")</strong></div>
    <div><span>Output tokens</span><strong>@Model.Run.OutputTokens.ToString("N0")</strong></div>
    <div><span>Cost</span><strong>$@Model.Run.CostUsd.ToString("0.0000")</strong></div>
    <div><span>Trigger</span><strong>@(Model.Run.Trigger ?? "—")</strong></div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.Run.TraceId))
{
    <section class="panel">
        <div class="panel-head"><div><p class="eyebrow">OPENTELEMETRY</p><h2>Trace identity</h2></div></div>
        <div class="rows">
            <div class="system-row"><div class="row-main"><strong>@Model.Run.TraceId</strong><span>OTLP trace id</span></div></div>
        </div>
    </section>
}

@if (Model.Run.FailureGroup is not null)
{
    var failure = Model.Run.FailureGroup;
    <section class="panel">
        <div class="panel-head"><div><p class="eyebrow">FAILURE FINGERPRINT</p><h2>@failure.Category</h2></div><span>@failure.Occurrences.ToString("N0") occurrences</span></div>
        <div class="rows">
            <div class="system-row"><div class="row-main"><strong>@failure.Operation</strong><span>Operation</span></div></div>
            @if (!string.IsNullOrWhiteSpace(failure.FailureType))
            {
                <div class="system-row"><div class="row-main"><strong>@failure.FailureType</strong><span>Failure type</span></div></div>
            }
            @if (!string.IsNullOrWhiteSpace(failure.Dependency))
            {
                <div class="system-row"><div class="row-main"><strong>@failure.Dependency</strong><span>Dependency</span></div></div>
            }
            @if (failure.HttpStatusCode.HasValue)
            {
                <div class="system-row"><div class="row-main"><strong>HTTP @failure.HttpStatusCode</strong><span>Status signal</span></div></div>
            }
            @if (!string.IsNullOrWhiteSpace(failure.MessageTemplate))
            {
                <div class="system-row"><div class="row-main"><strong>@failure.MessageTemplate</strong><span>Normalized message template</span></div></div>
            }
            <div class="system-row"><div class="row-main"><strong>@failure.Fingerprint</strong><span>Deterministic fingerprint</span></div></div>
        </div>
    </section>
}

<section class="panel">
    <div class="panel-head">
        <div><p class="eyebrow">TIMELINE</p><h2>Run events</h2></div>
        <span>@Model.LogEvents.Count logs · @Model.Spans.Count spans</span>
    </div>
    @if (Model.Timeline.Count == 0)
    {
        <div class="empty"><strong>No detailed telemetry reported.</strong><span>Spans and structured log events will appear here in timestamp order.</span></div>
    }
    else
    {
        <div class="run-timeline">
        @foreach (var item in Model.Timeline)
        {
            <div class="timeline-row @item.CssClass">
                <span class="timeline-time">@item.Timestamp.ToString("HH:mm:ss.fff")</span>
                <span class="timeline-kind">@item.Kind</span>
                <div class="timeline-content">
                    <strong>@item.Title</strong>
                    @if (!string.IsNullOrWhiteSpace(item.Subtitle))
                    {
                        <small>@item.Subtitle</small>
                    }
                    @if (!string.IsNullOrWhiteSpace(item.PropertiesJson))
                    {
                        <details>
                            <summary>Properties</summary>
                            <pre>@item.PropertiesJson</pre>
                        </details>
                    }
                </div>
                <span class="timeline-detail">@(item.Detail ?? string.Empty)</span>
            </div>
        }
        </div>
    }
</section>

<section class="panel trace-panel">
    <div class="panel-head"><div><p class="eyebrow">TRACE</p><h2>Execution</h2></div><span>@Model.Spans.Count spans</span></div>
    @if (Model.Spans.Count == 0)
    {
        <div class="empty"><strong>No spans reported.</strong><span>This run only contains its top-level timing and usage data.</span></div>
    }
    else
    {
        <div class="trace">
        @foreach (var span in Model.Spans)
        {
            var spanClass = span.Status.ToString().ToLowerInvariant();
            TimeSpan? spanDuration = span.CompletedAt is null ? null : span.CompletedAt.Value - span.StartedAt;
            <div class="trace-row">
                <span class="trace-line"></span>
                <span class="status-dot @spanClass"></span>
                <span class="trace-kind">@span.Kind</span>
                <strong>@span.Name</strong>
                <span class="trace-duration">@(spanDuration is null ? "running" : $"{spanDuration.Value.TotalMilliseconds:0} ms")</span>
            </div>
            @if (!string.IsNullOrWhiteSpace(span.ErrorType) || span.HttpStatusCode.HasValue)
            {
                <div class="muted">@(span.ErrorType ?? "error")@(span.HttpStatusCode.HasValue ? $" · HTTP {span.HttpStatusCode}" : string.Empty)</div>
            }
        }
        </div>
    }
</section>

@if (!string.IsNullOrWhiteSpace(Model.Run.Error))
{
    <section class="panel payload error-payload"><p class="eyebrow">ERROR</p><pre>@Model.Run.Error</pre></section>
}
@if (!string.IsNullOrWhiteSpace(Model.Run.InputJson))
{
    <section class="panel payload"><p class="eyebrow">INPUT</p><pre>@Model.Run.InputJson</pre></section>
}
@if (!string.IsNullOrWhiteSpace(Model.Run.OutputJson))
{
    <section class="panel payload"><p class="eyebrow">OUTPUT</p><pre>@Model.Run.OutputJson</pre></section>
}
