@page "/run/{id:guid}"
@model RunModel
@{
    ViewData["Title"] = Model.Run.Name;
    var statusClass = Model.Run.Status.ToString().ToLowerInvariant();
    TimeSpan? duration = Model.Run.CompletedAt is null ? null : Model.Run.CompletedAt.Value - Model.Run.StartedAt;
    var isRunning = Model.Run.Status == Monitor.Domain.RunStatus.Running;
}

@section Head {
    <link rel="stylesheet" href="~/css/run-live.css" asp-append-version="true" />
}

<div id="run-live-root"
     data-run-id="@Model.Run.Id"
     data-run-status="@Model.Run.Status"
     data-run-started-at="@Model.Run.StartedAt.ToString("O")"
     data-run-completed-at="@(Model.Run.CompletedAt?.ToString("O") ?? string.Empty)">

<header class="page-head compact run-head">
    <div>
        <p class="eyebrow">RUN / @Model.Run.Id</p>
        <h1 id="run-live-name">@Model.Run.Name</h1>
        <p class="lede">@Model.Run.Component.Name · @Model.Run.StartedAt.ToString("u")</p>
    </div>
    <div class="run-live-head-state">
        <div class="run-live-connection @(isRunning ? "connecting" : "frozen")" id="run-live-connection" aria-live="polite">
            <span></span>
            <strong>@(isRunning ? "Connecting" : "Historical · frozen")</strong>
        </div>
        <span class="run-status @statusClass" id="run-live-status">@Model.Run.Status</span>
    </div>
</header>

<button class="run-live-update-banner" id="run-live-update-banner" type="button" hidden>
    <strong id="run-live-update-count">1 update available</strong>
    <span>Refresh this frozen snapshot</span>
</button>

<section class="run-facts">
    <div><span>Duration</span><strong id="run-live-duration" data-live-duration data-started-at="@Model.Run.StartedAt.ToString("O")" data-completed-at="@(Model.Run.CompletedAt?.ToString("O") ?? string.Empty)">@(duration is null ? "running" : $"{duration.Value.TotalMilliseconds:0} ms")</strong></div>
    <div><span>Model</span><strong id="run-live-model">@(Model.Run.Model ?? "—")</strong></div>
    <div><span>Input tokens</span><strong id="run-live-input-tokens">@Model.Run.InputTokens.ToString("N0")</strong></div>
    <div><span>Output tokens</span><strong id="run-live-output-tokens">@Model.Run.OutputTokens.ToString("N0")</strong></div>
    <div><span>Cost</span><strong id="run-live-cost">$@Model.Run.CostUsd.ToString("0.0000")</strong></div>
    <div><span>Trigger</span><strong id="run-live-trigger">@(Model.Run.Trigger ?? "—")</strong></div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.Run.TraceId))
{
    <section class="panel">
        <div class="panel-head"><div><p class="eyebrow">OPENTELEMETRY</p><h2>Trace identity</h2></div></div>
        <div class="rows">
            <div class="system-row"><div class="row-main"><strong>@Model.Run.TraceId</strong><span>OTLP trace id</span></div></div>
        </div>
    </section>
}

@if (Model.Run.FailureGroup is not null)
{
    var failure = Model.Run.FailureGroup;
    <section class="panel" id="run-live-failure-panel">
        <div class="panel-head"><div><p class="eyebrow">FAILURE FINGERPRINT</p><h2>@failure.Category</h2></div><span>@failure.Occurrences.ToString("N0") occurrences</span></div>
        <div class="rows">
            <div class="system-row"><div class="row-main"><strong>@failure.Operation</strong><span>Operation</span></div></div>
            @if (!string.IsNullOrWhiteSpace(failure.FailureType))
            {
                <div class="system-row"><div class="row-main"><strong>@failure.FailureType</strong><span>Failure type</span></div></div>
            }
            @if (!string.IsNullOrWhiteSpace(failure.Dependency))
            {
                <div class="system-row"><div class="row-main"><strong>@failure.Dependency</strong><span>Dependency</span></div></div>
            }
            @if (failure.HttpStatusCode.HasValue)
            {
                <div class="system-row"><div class="row-main"><strong>HTTP @failure.HttpStatusCode</strong><span>Status signal</span></div></div>
            }
            @if (!string.IsNullOrWhiteSpace(failure.MessageTemplate))
            {
                <div class="system-row"><div class="row-main"><strong>@failure.MessageTemplate</strong><span>Normalized message template</span></div></div>
            }
            <div class="system-row"><div class="row-main"><strong>@failure.Fingerprint</strong><span>Deterministic fingerprint</span></div></div>
        </div>
    </section>
}

<section class="panel run-live-panel">
    <div class="panel-head">
        <div><p class="eyebrow">TIMELINE</p><h2>Run events</h2></div>
        <span><strong id="run-live-log-count">@Model.LogEvents.Count</strong> logs · <strong id="run-live-span-count">@Model.Spans.Count</strong> spans</span>
    </div>
    <div class="empty" id="run-live-timeline-empty" hidden="@(Model.Timeline.Count != 0)">
        <strong>No detailed telemetry reported.</strong><span>Spans and structured log events will appear here in timestamp order.</span>
    </div>
    <div class="run-timeline" id="run-live-timeline" hidden="@(Model.Timeline.Count == 0)">
        @foreach (var item in Model.Timeline)
        {
            <div class="timeline-row @item.CssClass">
                <span class="timeline-time">@item.Timestamp.ToString("HH:mm:ss.fff")</span>
                <span class="timeline-kind">@item.Kind</span>
                <div class="timeline-content">
                    <strong>@item.Title</strong>
                    @if (!string.IsNullOrWhiteSpace(item.Subtitle))
                    {
                        <small>@item.Subtitle</small>
                    }
                    @if (!string.IsNullOrWhiteSpace(item.PropertiesJson))
                    {
                        <details>
                            <summary>Properties</summary>
                            <pre>@item.PropertiesJson</pre>
                        </details>
                    }
                </div>
                <span class="timeline-detail">@(item.Detail ?? string.Empty)</span>
            </div>
        }
    </div>
</section>

<section class="panel trace-panel run-live-panel">
    <div class="panel-head"><div><p class="eyebrow">TRACE</p><h2>Execution</h2></div><span><strong id="run-live-trace-count">@Model.Spans.Count</strong> spans</span></div>
    <div class="empty" id="run-live-trace-empty" hidden="@(Model.Spans.Count != 0)">
        <strong>No spans reported.</strong><span>This run only contains its top-level timing and usage data.</span>
    </div>
    <div class="trace" id="run-live-trace" hidden="@(Model.Spans.Count == 0)">
        @foreach (var span in Model.Spans)
        {
            var spanClass = span.Status.ToString().ToLowerInvariant();
            TimeSpan? spanDuration = span.CompletedAt is null ? null : span.CompletedAt.Value - span.StartedAt;
            <div class="trace-row" data-live-span data-span-id="@span.Id" data-parent-span-id="@(span.ParentSpanId?.ToString() ?? string.Empty)" style="--trace-depth:0">
                <span class="trace-line"></span>
                <span class="status-dot @spanClass"></span>
                <span class="trace-kind">@span.Kind</span>
                <strong>@span.Name</strong>
                <span class="trace-duration" data-live-duration data-started-at="@span.StartedAt.ToString("O")" data-completed-at="@(span.CompletedAt?.ToString("O") ?? string.Empty)">@(spanDuration is null ? "running" : $"{spanDuration.Value.TotalMilliseconds:0} ms")</span>
            </div>
            @if (!string.IsNullOrWhiteSpace(span.ErrorType) || span.HttpStatusCode.HasValue)
            {
                <div class="muted">@(span.ErrorType ?? "error")@(span.HttpStatusCode.HasValue ? $" · HTTP {span.HttpStatusCode}" : string.Empty)</div>
            }
        }
    </div>
</section>

<section class="panel payload error-payload" id="run-live-error-panel" hidden="@string.IsNullOrWhiteSpace(Model.Run.Error)">
    <p class="eyebrow">ERROR</p><pre id="run-live-error">@(Model.Run.Error ?? string.Empty)</pre>
</section>

@if (!string.IsNullOrWhiteSpace(Model.Run.InputJson))
{
    <section class="panel payload"><p class="eyebrow">INPUT</p><pre>@Model.Run.InputJson</pre></section>
}

<section class="panel payload" id="run-live-output-panel" hidden="@string.IsNullOrWhiteSpace(Model.Run.OutputJson)">
    <p class="eyebrow">OUTPUT</p><pre id="run-live-output">@(Model.Run.OutputJson ?? string.Empty)</pre>
</section>

</div>

@section Scripts {
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
    <script src="~/js/run-live.js" asp-append-version="true"></script>
}
