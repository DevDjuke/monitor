@page "/account/setup"
@model Monitor.Web.Pages.Account.SetupModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Initial setup";
}

<section class="auth-card">
    <div class="auth-heading">
        <p class="eyebrow">FIRST RUN</p>
        <h1>Create owner</h1>
        <p>This page only exists in Development and only while Monitor has no users.</p>
    </div>

    <form method="post" class="auth-form">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <label asp-for="Input.Email"></label>
        <input asp-for="Input.Email" autocomplete="username" autofocus />
        <span asp-validation-for="Input.Email" class="field-error"></span>

        <label asp-for="Input.Password"></label>
        <input asp-for="Input.Password" autocomplete="new-password" />
        <span asp-validation-for="Input.Password" class="field-error"></span>

        <label asp-for="Input.ConfirmPassword"></label>
        <input asp-for="Input.ConfirmPassword" autocomplete="new-password" />
        <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>

        <button type="submit" class="primary-button">Create owner account</button>
    </form>

    <p class="auth-footnote">Password: at least 12 characters with uppercase, lowercase, and a number.</p>
</section>
