@page "/account/access-denied"
@model Monitor.Web.Pages.Account.AccessDeniedModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Access denied";
}

<div class="auth-card">
    <div class="auth-eyebrow">MONITOR</div>
    <h1>Access denied</h1>
    <p>Your account is signed in, but its role does not permit this operation.</p>
    <a class="auth-link-button" href="/">Return to overview</a>
</div>
