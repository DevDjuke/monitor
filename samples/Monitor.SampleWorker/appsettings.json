{
  "Monitor": {
    "BaseUrl": "http://localhost:5000",
    "IngestionApiKey": ""
  },
  "SampleWorker": {
    "ComponentName": "Sample Website Auditor",
    "Slug": "sample-website-auditor",
    "Environment": "development",
    "Version": "0.1.0",
    "TargetUrl": "https://example.com",
    "HeartbeatIntervalSeconds": 15,
    "RunIntervalSeconds": 30,
    "CommandPollIntervalSeconds": 2,
    "FailureEvery": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
